@startuml
skinparam ConditionEndStyle hline

title Алгоритм игрового цикла

start

:Получить дельту времени (float delta);

if (Состояние игры == State.GAME_OVER?) then (Да)
    :Ничего не делать;
    stop
else (Нет)
    :Обновить таймер спавна (spawnTimer);

    if (Идет обработка хода (turnProcessing == true)?) then (Да)
        :Движение и обновление снарядов (updateBalls);
        :Проверить коллизии шаров с блоками;
        :Проверить коллизии шаров с бонусами;
        :Проверить завершение хода (checkTurnEnd);
    else (Нет)
        if (Нужно заспавнить новую строку блоков?) then (Да)
            :Вызвать метод spawnRow();
            :Сдвинуть существующие блоки вниз;
            :Проверить пересечение линии пола (checkGameOver);
        endif
    endif

    :Обновить анимации остальных сущностей (updateEntities);
    :Удалить уничтоженные блоки и собранные бонусы;
endif

stop
@enduml
